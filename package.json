{
  "name": "frame-chopper",
  "version": "1.7.0",
  "description": "Videos to frames converter",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build"
  },
  "author": "py-rafasx",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.framechopper.app",
    "productName": "Frame Chopper",
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "publish": null,
    "files": [
      "src/**/*",
      "electron/**/*",
      "!**/node_modules/*/{test,tests,doc,docs,example,examples,benchmark,performance}/**",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.map",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/docs/**",
      "!**/examples/**",
      "!**/.vscode/**",
      "!**/settings.json",
      "!**/.gitignore"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "wmv",
          "flv",
          "webm",
          "m4v",
          "mpg",
          "mpeg",
          "3gp",
          "3g2",
          "ogv",
          "ts",
          "vob",
          "rm",
          "rmvb",
          "f4v"
        ],
        "name": "Video file",
        "role": "Viewer"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video",
      "fileAssociations": [
        { "ext": "mp4", "name": "Video file", "role": "Viewer" },
        { "ext": "mkv", "name": "Video file", "role": "Viewer" },
        { "ext": "avi", "name": "Video file", "role": "Viewer" },
        { "ext": "mov", "name": "Video file", "role": "Viewer" },
        { "ext": "wmv", "name": "Video file", "role": "Viewer" },
        { "ext": "flv", "name": "Video file", "role": "Viewer" },
        { "ext": "webm", "name": "Video file", "role": "Viewer" },
        { "ext": "m4v", "name": "Video file", "role": "Viewer" },
        { "ext": "mpg", "name": "Video file", "role": "Viewer" },
        { "ext": "mpeg", "name": "Video file", "role": "Viewer" },
        { "ext": "3gp", "name": "Video file", "role": "Viewer" },
        { "ext": "3g2", "name": "Video file", "role": "Viewer" },
        { "ext": "ogv", "name": "Video file", "role": "Viewer" },
        { "ext": "ts", "name": "Video file", "role": "Viewer" },
        { "ext": "vob", "name": "Video file", "role": "Viewer" },
        { "ext": "rm", "name": "Video file", "role": "Viewer" },
        { "ext": "rmvb", "name": "Video file", "role": "Viewer" },
        { "ext": "f4v", "name": "Video file", "role": "Viewer" }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    }
  }
}